rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public real-time cached Daily Tech Digest
    match /tech_digests/{digestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
