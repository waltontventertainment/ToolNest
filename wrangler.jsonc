{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolzaro",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toolzaro-blog-d1",
      "database_id": "toolzaro-blog-d1"
    }
  ]
}
