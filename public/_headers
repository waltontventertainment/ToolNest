# Security & Performance Headers for Cloudflare Pages & Netlify
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)
  X-XSS-Protection: 1; mode=block

# Prevent Search Engine Indexing of Secret Admin Workspace
/sabbir
  X-Robots-Tag: noindex, nofollow, noarchive
/sabbir.html
  X-Robots-Tag: noindex, nofollow, noarchive

# Aggressive immutable caching for Vite hashed production assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static PDF worker, CMap font tables, and offline JSON datasets
/pdf.worker.mjs
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

/cmaps/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=86400
  Content-Type: application/json; charset=utf-8

# Domain Favicons, App Icons & Social Preview Banner
/favicon.ico
  Cache-Control: public, max-age=604800
  Content-Type: image/x-icon

/favicon.svg
  Cache-Control: public, max-age=604800
  Content-Type: image/svg+xml

/favicon*.png
  Cache-Control: public, max-age=604800
  Content-Type: image/png

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
  Content-Type: image/png

/android-chrome-*.png
  Cache-Control: public, max-age=604800
  Content-Type: image/png

/logo.png
  Cache-Control: public, max-age=604800
  Content-Type: image/png

/og-banner.jpg
  Cache-Control: public, max-age=604800
  Content-Type: image/jpeg

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

# SEO Sitemaps, RSS Feeds, AdSense & Crawler Files
/sitemap*.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/rss.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

/feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/ads.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/app-ads.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/humans.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
