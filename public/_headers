# Security, Crawler & Performance Headers for Cloudflare Pages & Workers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)

# Prevent Search Engine Indexing of Secret Admin Workspace Only
/sabbir
  X-Robots-Tag: noindex, nofollow, noarchive
/sabbir.html
  X-Robots-Tag: noindex, nofollow, noarchive
/sabbirhasan23m
  X-Robots-Tag: noindex, nofollow, noarchive
/sabbirhasan23m.html
  X-Robots-Tag: noindex, nofollow, noarchive

# Aggressive immutable caching for Vite hashed production JS/CSS chunks
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Static PDF worker, CMap font tables, and offline JSON datasets
/pdf.worker.mjs
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

/cmaps/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=86400
  Content-Type: application/json; charset=utf-8

